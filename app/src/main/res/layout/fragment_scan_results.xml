<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <com.example.scanview.visualization.ScanViewVisualizationView
        android:id="@+id/visualizationView"
        android:layout_width="match_parent"
        android:layout_height="692dp"
        android:layout_weight="1"
        android:background="#000000"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Нет записанных взаимодействий.\n\nПерейдите на экран «Профиль» чтобы загрузить сессию,\nили запишите новые взаимодействия."
        android:textSize="14sp"
        android:textColor="#555566"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <SeekBar
        android:id="@+id/seekBarTimeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:visibility="invisible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerInteractions"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="#0A0A14"
        android:clipToPadding="false"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:gravity="center_vertical"
        android:background="#0A0A14">

        <TextView
            android:id="@+id/tvInteractionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#666688"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSaveSession"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:text="Сохранить"
            android:textSize="11sp"
            android:backgroundTint="#1565C0"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Очистить"
            android:textSize="11sp"
            android:backgroundTint="#6B0020" />

    </LinearLayout>

</LinearLayout>
