<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.6"
            android:background="@drawable/header_glow_gradient" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvCurrentScreenHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:shadowColor="#00C853"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="20"
                android:text="SCANNING..."
                android:textColor="#00C853"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_marginTop="4dp"
                android:background="#4D00C853" />
        </LinearLayout>
    </FrameLayout>

    <com.example.scanview.visualization.ScanViewVisualizationView
        android:id="@+id/visualizationContainer"
        android:layout_width="match_parent"
        android:layout_height="329dp"
        android:layout_weight="1" />

    <SeekBar
        android:id="@+id/seekBarTimeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:thumbTint="#00C853"
        android:progressTint="#2200C853" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="69dp"
        android:background="#0A0A0A"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#151515"
            android:text="СБРОСИТЬ"
            android:textAllCaps="false"
            android:textColor="#FF5252" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="#202020"
            android:text="ВЫЙТИ"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewInteractions"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#0A0A0A"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="История пуста"
        android:textColor="#444444"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

</LinearLayout>
